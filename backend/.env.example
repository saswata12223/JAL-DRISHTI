# FlashFloodAI Backend Environment Configuration Example
PROJECT_NAME="FlashFloodAI Backend REST API"
VERSION="7.0.0"
DEBUG=false
HOST=0.0.0.0
PORT=8000

# PostgreSQL / PostGIS / TimescaleDB Connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=flashfloodai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# Direct connection URI override (optional)
DATABASE_URL=postgresql+psycopg2://postgres:your_secure_password_here@localhost:5432/flashfloodai

# Machine Learning Artifact Locations
ML_MODEL_PATH=C:/FlashFloodAI/data/processed/ml/models/final_flood_risk_model.joblib
ML_ALLOWLIST_PATH=C:/FlashFloodAI/data/processed/ml/model_feature_allowlist.json
ML_DECISION_THRESHOLD=0.40

# OpenWeather API Key (Backend-only live weather integration)
OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY

